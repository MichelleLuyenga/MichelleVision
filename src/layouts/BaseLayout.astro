---
// src/layouts/BaseLayout.astro
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import Analytics from '@vercel/analytics/astro';
import IndexNowSubmit from '../components/IndexNowSubmit.astro';
import SocialCard from '../components/SocialCard.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  author?: string;
  tags?: string | string[];
  noindex?: boolean;
}

const {
  title = 'Michelle Sadsad Luyenga | Marketing Web Developer',
  description,
  image,
  imageAlt,
  type = 'website',
  publishedTime,
  modifiedTime,
  author,
  tags,
  noindex = false,
} = Astro.props;

// Fetch the GA ID from your environment file
const GA_MEASUREMENT_ID = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#090A0C" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.ico" />

    <!-- Title, description, canonical, Open Graph, Twitter Card, JSON-LD -->
    <SocialCard
      title={title}
      description={description}
      image={image}
      imageAlt={imageAlt}
      type={type}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      author={author}
      tags={tags}
      noindex={noindex}
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;600&family=Inter:wght@300;400;600&display=swap"
      rel="stylesheet"
    />

    {GA_MEASUREMENT_ID && <GoogleAnalytics measurementId={GA_MEASUREMENT_ID} />}
    <Analytics />

    <meta name="msvalidate.01" content="1D2BDC1F149FF416BC7895DAF1DEAA96" />

    <!-- <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6570356393715540"
     crossorigin="anonymous"></script> -->
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>

    <Header />

    <main id="main" class="container-max main-content">
      <slot />
      <IndexNowSubmit />
    </main>

    <Footer />
  </body>
</html>

<style is:global>
  /* Matches the dark theme so there is no white flash while CSS loads */
  html { background-color: #090A0C; }
</style>

<style>
  .skip-link {
    position: absolute;
    left: 1rem;
    top: -4rem;
    background: #C9A96E;
    color: #0D0E11;
    padding: 0.6rem 1rem;
    border-radius: 0.25rem;
    font-family: 'Fira Code', monospace;
    font-size: 0.8125rem;
    text-decoration: none;
    z-index: 100;
  }
  .skip-link:focus { top: 1rem; }
</style>
