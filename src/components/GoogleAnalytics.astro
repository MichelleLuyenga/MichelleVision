---
/* Google Analytics 4 Tracking Component
   - Supports Astro View Transitions
   - Includes Consent Mode v2 defaults (GDPR/CCPA ready)
   - Dynamic debug mode for local development
*/
interface Props {
  measurementId: string;
}

const { measurementId } = Astro.props;
const isDev = import.meta.env.DEV;
---

<!-- Performance: Preconnect to GA servers -->
<link rel="preconnect" href="https://www.googletagmanager.com" />
<link rel="dns-prefetch" href="https://www.googletagmanager.com" />

<script async src={`https://www.googletagmanager.com/gtag/js?id=${measurementId}`}></script>

<script is:inline define:vars={{ measurementId, isDev }}>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}

  // 1. Initialize Consent Mode v2 (Default to DENIED)
  // Update these via your cookie banner's "Accept" button
  gtag('consent', 'default', {
    'ad_storage': 'denied',
    'ad_user_data': 'denied',
    'ad_personalization': 'denied',
    'analytics_storage': 'denied'
  });

  gtag('js', new Date());

  // 2. Configure GA4
  gtag('config', measurementId, {
    // Disable automatic page_view so we can handle it with Astro's router
    send_page_view: false,
    debug_mode: isDev
  });

  // 3. Handle Page Views (Initial load + View Transitions)
  function trackPageView() {
    // GA4 Best Practice: Use page_location and page_title
    gtag('event', 'page_view', {
      page_title: document.title,
      page_location: window.location.href
    });
  }

  // Fire on initial load
  trackPageView();

  // Fire on Astro client-side navigations (View Transitions)
  document.addEventListener('astro:page-load', () => {
    trackPageView();
  });
</script>