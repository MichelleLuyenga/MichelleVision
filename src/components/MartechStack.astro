---
// src/components/MartechStack.astro
const layers = [
  {
    id: 'E-COMMERCE',
    title: 'E-commerce',
    desc: 'Headless storefronts with fast product pages, carts, and checkout that stay in sync with inventory and orders.',
    tools: ['Shopify', 'Stripe'],
  },
  {
    id: 'CMS',
    title: 'Content management',
    desc: 'Editor-friendly content models so marketing teams publish without waiting on developers.',
    tools: ['Sanity'],
  },
  {
    id: 'CDP',
    title: 'Customer data platform',
    desc: 'One customer profile, built from every site visit, purchase, and form, then sent to the tools that need it.',
    tools: ['Segment'],
  },
  {
    id: 'CRM',
    title: 'CRM',
    desc: 'Forms, quotes, and sign-ups create or update contacts and deals automatically, with source data attached.',
    tools: ['HubSpot'],
  },
  {
    id: 'ANALYTICS',
    title: 'Analytics',
    desc: 'Event tracking that is planned up front, consent-aware, and consistent across web, email, and ads.',
    tools: ['GA4', 'Google Tag Manager', 'Looker Studio'],
  },
  {
    id: 'AUTOMATION',
    title: 'Marketing automation',
    desc: 'Welcome series, abandoned-cart flows, and lead scoring triggered by what people actually do on the site.',
    tools: ['HubSpot Marketing', 'Mailchimp'],
  },
  {
    id: 'ADVERTISING',
    title: 'Advertising',
    desc: 'Server-side conversion tracking and audience syncs so ad platforms optimize on real revenue, not guesses.',
    tools: ['Google Ads', 'Meta Conversions API'],
  },
  {
    id: 'MARKETING',
    title: 'Marketing & SEO',
    desc: 'Landing pages, structured data, A/B tests, and campaign tracking built into the site from day one.',
    tools: ['Schema.org markup', 'XML sitemaps', 'UTM governance'],
  },
  {
    id: 'WORKFLOW',
    title: 'Workflow integration',
    desc: 'Webhooks and automations that move leads, orders, and tasks between systems with retries and alerting.',
    tools: ['Make', 'Zapier'],
  },
];

const flow = ['Your website', 'CDP', 'CRM', 'Automation', 'Ads & analytics'];
---

<section class="stack-section" aria-labelledby="stack-heading">
  <div class="stack-header">
    <p class="tag-mono accent-text">// FULL_MARTECH_STACK</p>
    <h2 id="stack-heading" class="stack-title">One connected stack, whatever platform your site runs on</h2>
    <p class="text-muted stack-sub">
      Most teams already pay for these tools. The gap is usually the wiring between them. I connect your website to the systems you use, so data flows both ways and nothing is re-entered by hand.
    </p>
  </div>

  <ol class="flow tag-mono" aria-label="Typical data flow">
    {flow.map((step, i) => (
      <li class="flow-step">
        <span>{step}</span>
        {i < flow.length - 1 && <span class="flow-arrow" aria-hidden="true">&rarr;</span>}
      </li>
    ))}
  </ol>

  <div class="layer-grid">
    {layers.map((layer) => (
      <article class="layer-card">
        <p class="tag-mono layer-id">{layer.id}</p>
        <h3 class="layer-name">{layer.title}</h3>
        <p class="text-muted layer-desc">{layer.desc}</p>
        <ul class="tool-list tag-mono">
          {layer.tools.map((tool) => <li>{tool}</li>)}
        </ul>
      </article>
    ))}
  </div>
  <p class="stack-note text-muted">Using a different tool? Ask. I will tell you honestly whether I can connect it.</p>
</section>

<style>
  .stack-section { max-width: 64rem; margin: 5rem auto; padding: 0 1.25rem; }
  .stack-header { margin-bottom: 2rem; }
  .accent-text { color: #C9A96E; }
  .stack-title { font-size: 2rem; color: #EDE9F0; line-height: 1.2; margin: 0.75rem 0 1rem; }
  .stack-sub { font-size: 1rem; line-height: 1.6; max-width: 46rem; margin: 0; }
  .flow { display: flex; flex-wrap: wrap; gap: 0.5rem; list-style: none; padding: 0; margin: 0 0 2.5rem; font-size: 0.75rem; color: #EDE9F0; }
  .flow-step { display: flex; align-items: center; gap: 0.5rem; }
  .flow-step > span:first-child { background: #111317; border: 1px solid #1A1C23; padding: 0.4rem 0.75rem; border-radius: 0.25rem; }
  .flow-arrow { color: #C9A96E; }
  .layer-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; }
  .layer-card { background: #111317; border: 1px solid #1A1C23; padding: 1.5rem; border-radius: 0.375rem; display: flex; flex-direction: column; }
  .layer-id { font-size: 0.65rem; color: #C9A96E; margin: 0 0 0.5rem; }
  .layer-name { font-size: 1.125rem; color: #EDE9F0; margin: 0 0 0.5rem; }
  .layer-desc { font-size: 0.875rem; line-height: 1.55; margin: 0 0 1.25rem; flex-grow: 1; }
  .tool-list { list-style: none; padding: 1rem 0 0; margin: 0; border-top: 1px solid #1A1C23; display: flex; flex-wrap: wrap; gap: 0.4rem; font-size: 0.7rem; color: #D4D4D8; }
  .tool-list li { background: #0D0E11; border: 1px solid #1A1C23; padding: 0.2rem 0.5rem; border-radius: 0.25rem; }
  .stack-note { font-size: 0.9rem; margin: 1.5rem 0 0; }
  .tag-mono { font-family: 'Fira Code', monospace; }
  .text-muted { color: #888; }
  @media (max-width: 768px) { .stack-title { font-size: 1.625rem; } }
</style>
