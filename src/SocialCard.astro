---
// src/components/SocialCard.astro
// Renders the page <title>, meta description, canonical URL, Open Graph and
// Twitter Card tags, and JSON-LD structured data. Used inside <head> by
// BaseLayout.astro, which forwards page-level props to it.

interface Props {
  title: string;
  description?: string;
  /** Absolute or site-relative path (e.g. "/og/post/my-post.png"). Falls back to the generated home card. */
  image?: string;
  /** Alt text for the share image. Defaults to the page title. */
  imageAlt?: string;
  /** "website" for general pages, "article" for blog posts */
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  author?: string;
  /** Blog topic/tag(s): accepts the site's single-string topic or an array */
  tags?: string | string[];
  /** Keep this page out of search results (thank-you pages, drafts, etc.) */
  noindex?: boolean;
}

// ---- Site-wide defaults: edit these to match your site -------------------
const SITE_NAME = 'MichelleVision';
const PERSON_NAME = 'Michelle Sadsad Luyenga';
const JOB_TITLE = 'Marketing Web Developer';
const SITE_DESCRIPTION =
  'Marketing web developer building fast, measurable websites on Astro and Next.js, connected to your CRM, CDP, analytics, email automation, and ad platforms.';
// Uses the card generated by src/pages/og/[type]/[slug].png.ts, so no manual image is needed.
const DEFAULT_OG_IMAGE = '/og/home/index.png';
const TWITTER_HANDLE = ''; // set to '' to omit twitter:site
// Add GitHub, LinkedIn, and other profile URLs. Used for Person schema.
const SAME_AS: string[] = [
  'https://github.com/michelleluyenga',
  'https://www.linkedin.com/in/michelleluyenga',
];
const KNOWS_ABOUT = [
  'Astro',
  'Next.js',
  'Marketing Technology',
  'Headless CMS',
  'E-commerce',
  'Customer Data Platforms',
  'CRM Integration',
  'Marketing Automation',
  'Google Analytics 4',
  'Server-Side Tracking',
  'Core Web Vitals',
  'Technical SEO',
  'Data Migration',
  'Workflow Automation',
  'TypeScript',
];
// ----------------------------------------------------------------------

const {
  title,
  description = SITE_DESCRIPTION,
  image,
  imageAlt,
  type = 'website',
  publishedTime,
  modifiedTime,
  author,
  tags,
  noindex = false,
} = Astro.props;

// Set `site` in astro.config.mjs so canonical and image URLs are absolute and
// matching real domain. Falls back to the current origin so builds don't crash.
const site = Astro.site ?? new URL(Astro.url.origin);
const canonicalURL = new URL(Astro.url.pathname, site);
const resolvedImage = new URL(image || DEFAULT_OG_IMAGE, site).toString();
const resolvedImageAlt = imageAlt || title;

const topicList = Array.isArray(tags) ? tags : tags ? [tags] : [];
const isHome = Astro.url.pathname === '/';
const isArticle = type === 'article';

// Structured data: Person + WebSite on the home page, BlogPosting on articles.
const graph: Record<string, unknown>[] = [];

if (isHome) {
  graph.push(
    {
      '@type': 'Person',
      '@id': `${site.origin}/#person`,
      name: PERSON_NAME,
      jobTitle: JOB_TITLE,
      url: site.origin,
      knowsAbout: KNOWS_ABOUT,
      sameAs: SAME_AS.length ? SAME_AS : undefined,
    },
    {
      '@type': 'WebSite',
      '@id': `${site.origin}/#website`,
      name: SITE_NAME,
      url: site.origin,
      description: SITE_DESCRIPTION,
      publisher: { '@id': `${site.origin}/#person` },
    }
  );
}

if (isArticle) {
  graph.push({
    '@type': 'BlogPosting',
    headline: title,
    description,
    image: resolvedImage,
    datePublished: publishedTime?.toISOString(),
    dateModified: (modifiedTime ?? publishedTime)?.toISOString(),
    author: { '@type': 'Person', name: author || PERSON_NAME },
    publisher: { '@type': 'Person', name: PERSON_NAME, url: site.origin },
    mainEntityOfPage: canonicalURL.toString(),
    keywords: topicList.length ? topicList.join(', ') : undefined,
  });
}

const jsonLd = graph.length ? { '@context': 'https://schema.org', '@graph': graph } : null;
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:locale" content="en_US" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:image" content={resolvedImage} />
<meta property="og:image:alt" content={resolvedImageAlt} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

{isArticle && publishedTime && (
  <meta property="article:published_time" content={publishedTime.toISOString()} />
)}
{isArticle && modifiedTime && (
  <meta property="article:modified_time" content={modifiedTime.toISOString()} />
)}
{isArticle && <meta property="article:author" content={author || PERSON_NAME} />}
{isArticle && topicList.length > 0 && <meta property="article:section" content={topicList[0]} />}
{isArticle && topicList.map((tag) => <meta property="article:tag" content={tag} />)}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
{TWITTER_HANDLE && <meta name="twitter:site" content={TWITTER_HANDLE} />}
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={resolvedImage} />
<meta name="twitter:image:alt" content={resolvedImageAlt} />

{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
