---
// src/pages/cases.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import { ogWork } from '../lib/og';
import { samples, LAUNCH_TEXT, LAUNCH_LABEL } from '../lib/platforms';

// Portfolio case studies. They show my approach on realistic scenarios.
// They are not client engagements, so they state goals, not measured results.
// Replace with real client work and measured numbers when you have them.
const cases = [
  {
    id: 'CASE_01_LEGACY_MIGRATION',
    focus: 'DATA_MIGRATION & ASTRO',
    title: 'Legacy CMS to Headless Astro Migration',
    desc: 'How I would move a high-traffic legacy CMS and relational database to an Astro frontend with a modern headless CMS, with the goal of lower server overhead and faster page loads.',
    steps: [
      { label: 'LEGACY AUDIT', text: 'Map database schemas, plugin dependencies, and routing, and list every URL that needs a redirect.' },
      { label: 'DATA MIGRATION', text: 'Write ETL scripts to move content and assets, then verify record counts and spot-check pages before cutover.' },
      { label: 'TARGETS', text: 'Strong Core Web Vitals, a zero-downtime deployment on Vercel, and secure API handoffs.' },
    ],
  },
  {
    id: 'CASE_02_SYSTEM_INTEGRATION',
    focus: 'ERP, CRM & COMPANY DASHBOARD',
    title: 'Unified Company Dashboard & System Integration',
    desc: 'A design for a secure internal dashboard built on Astro server endpoints that pulls data from CRM, ERP, and BI tools into one view.',
    steps: [
      { label: 'SYSTEM INTEGRATION', text: 'Use webhook handlers and API connectors to link separate CRM and ERP platforms into one hub.' },
      { label: 'SECURE DASHBOARD', text: 'Build responsive, role-based views for company metrics and KPI tracking.' },
      { label: 'TARGETS', text: 'Remove data silos and cut the time spent on manual reporting.' },
    ],
  },
];
---

<BaseLayout
  title="Case Studies & Sample Builds | Astro, WordPress & Webflow"
  description="Portfolio case studies on migration and integration, plus sample builds on Astro and Next.js with GA4, CRM, CDP, automation, and ad tracking, launching Q1 2027."
  image={ogWork('cases')}
>
  <section class="cases-container">
    <div class="cases-header">
      <p class="tag-mono accent-text">// CASE_STUDIES // SAMPLE_BUILDS</p>
      <h1 class="page-heading">Case Studies & Sample Builds</h1>
      <p class="text-muted subtitle">
        Two portfolio case studies that show how I approach migrations and integrations, followed by two sample builds, one per platform, that I am publishing to show the same tracking and CRM setup across Astro and Next.js.
      </p>
    </div>

    <a href="/cases/michellevision" class="featured-case">
      <span class="tag-mono accent-text">// FEATURED_CASE_STUDY</span>
      <strong class="featured-title">How I designed MichelleVision</strong>
      <span class="text-muted">The goals, design system, key pages, and technical choices behind this site.</span>
      <span class="tag-mono accent-text">READ_THE_CASE_STUDY &rarr;</span>
    </a>

    <h2 class="group-title tag-mono">// PORTFOLIO_CASE_STUDIES</h2>
    <p class="text-muted group-note">
      These show how I approach the work. They are not client engagements, and the targets are goals, not measured results.
    </p>
    <div class="cases-stack">
      {cases.map((c) => (
        <article class="case-card">
          <div class="case-meta tag-mono">
            <span>[ PORTFOLIO_CASE_STUDY: {c.id} ]</span>
            <span class="text-muted">FOCUS: {c.focus}</span>
          </div>
          <h3 class="case-title">{c.title}</h3>
          <p class="text-muted case-desc">{c.desc}</p>
          <div class="framework-grid">
            {c.steps.map((s, i) => (
              <div class="framework-block">
                <h4 class="tag-mono accent-text">{String(i + 1).padStart(2, '0')} / {s.label}</h4>
                <p class="text-muted">{s.text}</p>
              </div>
            ))}
          </div>
        </article>
      ))}
    </div>

    <h2 class="group-title tag-mono">// SAMPLE_BUILDS &mdash; {LAUNCH_TEXT.toUpperCase()}</h2>
    <p class="text-muted group-note">
      These are in progress. Each one will show real before-and-after numbers and a diagram of its tracking plan once published.
    </p>
    <div class="cases-stack">
      {samples.map((s) => (
        <article class="case-card sample-card">
          <div class="case-meta tag-mono">
            <span>[ {s.id} ]</span>
            {s.status === 'LIVE' && s.url
              ? <a href={s.url} class="status live">LIVE &rarr;</a>
              : <span class="status">{LAUNCH_LABEL}</span>}
          </div>
          <p class="tag-mono platform-tag">PLATFORM: {s.platform}</p>
          <h3 class="case-title">{s.title}</h3>
          <p class="text-muted case-desc">{s.desc}</p>
          <div class="framework-grid">
            {s.steps.map((step, i) => (
              <div class="framework-block">
                <h4 class="tag-mono accent-text">{String(i + 1).padStart(2, '0')} / {step.label}</h4>
                <p class="text-muted">{step.text}</p>
              </div>
            ))}
          </div>
        </article>
      ))}
    </div>

    <div class="cases-cta">
      <a href="/platforms" class="cta-secondary tag-mono">WHICH_PLATFORM_FITS?</a>
      <a href="/contact?stream=consultation" class="cta-primary tag-mono">START_A_PROJECT &rarr;</a>
    </div>
  </section>
</BaseLayout>

<style>
  .cases-container { max-width: 64rem; margin: 4rem auto; padding: 0 1.25rem; }
  .cases-header { margin-bottom: 3.5rem; }
  .accent-text { color: #C9A96E; }
  .page-heading { font-size: 2.5rem; color: #EDE9F0; margin: 1rem 0; }
  .subtitle { font-size: 1.05rem; line-height: 1.6; max-width: 48rem; }
  .featured-case { display: flex; flex-direction: column; gap: 0.5rem; background: #111317; border: 1px solid #C9A96E; border-radius: 0.375rem; padding: 1.75rem; margin-bottom: 3rem; text-decoration: none; }
  .featured-case:hover { background: #16181F; }
  .featured-case:focus-visible { outline: 2px solid #C9A96E; outline-offset: 3px; }
  .featured-title { font-size: 1.5rem; color: #EDE9F0; line-height: 1.3; }
  .group-title { font-size: 0.875rem; color: #C9A96E; font-weight: normal; margin: 0 0 1.5rem; }
  .group-note { font-size: 0.95rem; margin: -0.5rem 0 1.5rem; max-width: 44rem; }
  .cases-stack { display: flex; flex-direction: column; gap: 2.5rem; margin-bottom: 4rem; }
  .case-card { background: #111317; border: 1px solid #1A1C23; padding: 2.5rem; border-radius: 0.375rem; }
  .sample-card { border-style: dashed; }
  .case-meta { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; font-size: 0.75rem; color: #C9A96E; margin-bottom: 1rem; }
  .status { border: 1px solid #1A1C23; background: rgba(201, 169, 110, 0.08); padding: 0.15rem 0.5rem; border-radius: 0.25rem; font-size: 0.65rem; }
  .status.live { text-decoration: none; color: #0D0E11; background: #C9A96E; }
  .platform-tag { font-size: 0.75rem; color: #888; margin: 0 0 0.5rem; }
  .case-title { font-size: 1.75rem; color: #EDE9F0; margin: 0 0 1rem 0; }
  .case-desc { font-size: 1rem; line-height: 1.6; margin-bottom: 2rem; }
  .framework-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.5rem; background: #0D0E11; border: 1px solid #1A1C23; padding: 1.5rem; border-radius: 0.25rem; }
  .framework-block h4 { font-size: 0.8125rem; margin-top: 0; margin-bottom: 0.5rem; }
  .framework-block p { font-size: 0.875rem; line-height: 1.5; margin: 0; }
  .cases-cta { display: flex; flex-wrap: wrap; gap: 1rem; }
  .cta-primary { background: #C9A96E; color: #0D0E11; padding: 0.875rem 1.5rem; border-radius: 0.25rem; text-decoration: none; font-weight: bold; font-size: 0.8125rem; }
  .cta-secondary { background: transparent; color: #EDE9F0; border: 1px solid #1A1C23; padding: 0.875rem 1.5rem; border-radius: 0.25rem; text-decoration: none; font-size: 0.8125rem; }
  .cta-primary:focus-visible, .cta-secondary:focus-visible { outline: 2px solid #C9A96E; outline-offset: 3px; }
  .tag-mono { font-family: 'Fira Code', monospace; }
  .text-muted { color: #888; }
  @media (max-width: 768px) { .page-heading { font-size: 2rem; } .case-card { padding: 1.5rem; } .case-title { font-size: 1.375rem; } .cta-primary, .cta-secondary { width: 100%; text-align: center; box-sizing: border-box; } }
</style>
