---
// src/pages/services.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import { ogWork } from '../lib/og';

const packages = [
  {
    level: 'PACKAGE_01',
    name: 'Legacy Migration & Integration',
    platforms: 'Astro',
    target: 'For established companies moving a legacy site or monolith to a modern stack without losing data or search rankings.',
    price: 'From $6,500',
    features: [
      'Full legacy data and URL migration with redirects',
      'Headless CMS setup and editor training',
      'CRM form and lead routing integration',
      'GA4 and tag manager setup with consent handling',
      'Production deployment on Vercel or Cloudflare',
    ],
    cta: 'Start a migration',
    featured: false,
  },
  {
    level: 'PACKAGE_02',
    name: 'Turnkey Design, Build & Scale',
    platforms: 'Astro or Next.js',
    target: 'Complete end-to-end solution from UI design to a fully connected marketing and sales stack.',
    price: 'From $12,000',
    features: [
      'Custom UI/UX design and brand system',
      'High-performance Astro or Next.js build',
      'CDP, CRM, and marketing automation integration',
      'Analytics event plan and ad conversion tracking',
      'Scoped API, ERP, and BI integrations',
      'Launch QA, security hardening & handoff documentation',
    ],
    cta: 'Start a turnkey project',
    featured: true,
  },
  {
    level: 'PACKAGE_03',
    name: 'Headless Commerce & Growth',
    platforms: 'Next.js with Shopify or Stripe',
    target: 'For online shops that want faster pages, cleaner data, and email and ads that act on real purchase behavior.',
    price: 'From $8,500',
    features: [
      'Headless storefront build',
      'Product feeds for Google and Meta shopping',
      'Abandoned-cart and post-purchase flows',
      'Server-side purchase tracking for Google and Meta Ads',
      'Scoped order, inventory, and fulfillment automation',
    ],
    cta: 'Start a commerce project',
    featured: false,
  },
];

const modules = [
  { name: 'E-commerce', detail: 'Storefront, checkout, product feeds, subscriptions' },
  { name: 'CMS', detail: 'Content models, previews, roles, multilingual content' },
  { name: 'CDP', detail: 'Event schema, identity resolution, audience sync' },
  { name: 'CRM', detail: 'Lead capture, deal creation, lifecycle stages, sync' },
  { name: 'Analytics', detail: 'Event plan, dashboards, consent mode, attribution' },
  { name: 'Marketing automation', detail: 'Email and SMS flows, lead scoring, segmentation' },
  { name: 'Advertising', detail: 'Conversion APIs, remarketing audiences, UTM governance' },
  { name: 'Workflow integration', detail: 'Make or Zapier flows with error alerts' },
];

---

<BaseLayout
  title="Marketing Web Development Packages | Astro & Next.js"
  description="Fixed-scope packages for marketing websites on Astro and Next.js: builds, migrations, optimization, e-commerce, CRM, CDP, analytics, marketing automation, and ad tracking."
  image={ogWork('services')}
>
  <section class="services-container">
    <div class="services-header">
      <p class="tag-mono accent-text">// TURNKEY_PACKAGES // DESIGN_BUILD_INTEGRATE_HOST</p>
      <h1 class="page-heading">Marketing Web Development Packages</h1>
      <p class="text-muted subtitle">
        Fixed-scope packages that cover the full lifecycle: design, build or optimization, the integrations that connect your marketing and sales tools, and managed hosting. Not sure which platform you need? <a href="/platforms" class="accent-text">Read the platform guide</a>.
      </p>
    </div>

    <div class="tiers-grid">
      {packages.map((pkg) => (
        <div class:list={['tier-card', { 'featured-card': pkg.featured }]}>
          {pkg.featured && <div class="featured-badge tag-mono">RECOMMENDED</div>}
          <div class="tier-top">
            <span class:list={['tag-mono tier-level', { 'accent-text': pkg.featured }]}>[ {pkg.level} ]</span>
            <h2 class="tier-name">{pkg.name}</h2>
            <p class="tag-mono tier-platforms">PLATFORMS: {pkg.platforms}</p>
            <p class="text-muted tier-target">{pkg.target}</p>
          </div>
          <div class:list={['tier-price tag-mono', { 'accent-text': pkg.featured }]}>
            {pkg.price} <span class="price-freq">/ PROJECT</span>
          </div>
          <ul class="tier-features">
            {pkg.features.map((f) => <li>{f}</li>)}
          </ul>
          <a href="/contact?stream=consultation" class:list={['tier-btn tag-mono', { 'featured-btn': pkg.featured }]}>
            {pkg.cta} &rarr;
          </a>
        </div>
      ))}
    </div>

    <div class="modules">
      <h2 class="modules-title">Need just one piece?</h2>
      <p class="text-muted modules-sub">Any integration below can be scoped on its own or added to a package.</p>
      <dl class="module-grid">
        {modules.map((m) => (
          <div class="module">
            <dt class="tag-mono">{m.name}</dt>
            <dd class="text-muted">{m.detail}</dd>
          </div>
        ))}
      </dl>
      <a href="/contact?stream=consultation" class="module-link tag-mono">Request a custom quote &rarr;</a>
    </div>
  </section>
</BaseLayout>

<style>
  .services-container { max-width: 64rem; margin: 4rem auto; padding: 0 1.25rem; }
  .services-header { margin-bottom: 3rem; }
  .accent-text { color: #C9A96E; }
  .page-heading { font-size: 2.5rem; color: #EDE9F0; margin: 1rem 0; }
  .subtitle { font-size: 1.05rem; line-height: 1.6; max-width: 48rem; }
  .tiers-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem; }
  .tier-card { background: #111317; border: 1px solid #1A1C23; padding: 2rem; border-radius: 0.375rem; display: flex; flex-direction: column; justify-content: space-between; position: relative; }
  .featured-card { border-color: #C9A96E; background: linear-gradient(135deg, #111317 0%, #16181F 100%); }
  .featured-badge { position: absolute; top: -12px; right: 2rem; background: #C9A96E; color: #0D0E11; font-size: 0.65rem; padding: 0.2rem 0.5rem; border-radius: 0.25rem; font-weight: bold; }
  .tier-level { font-size: 0.75rem; color: #888; }
  .tier-name { font-size: 1.5rem; color: #EDE9F0; margin: 0.5rem 0; }
  .tier-platforms { font-size: 0.7rem; color: #C9A96E; margin: 0 0 0.75rem; line-height: 1.5; }
  .tier-target { font-size: 0.875rem; line-height: 1.5; margin-bottom: 1.5rem; }
  .tier-price { font-size: 1.75rem; color: #EDE9F0; font-weight: bold; margin-bottom: 1.5rem; border-top: 1px solid #1A1C23; border-bottom: 1px solid #1A1C23; padding: 1rem 0; }
  .price-freq { font-size: 0.75rem; color: #888; font-weight: normal; }
  .tier-features { list-style: none; padding: 0; margin: 0 0 2rem 0; font-size: 0.875rem; line-height: 1.45; color: #D4D4D8; display: flex; flex-direction: column; gap: 0.75rem; flex-grow: 1; }
  .tier-features li { padding-left: 1.25rem; position: relative; }
  .tier-features li::before { content: '✓'; position: absolute; left: 0; color: #C9A96E; }
  .tier-btn { background: #1A1C23; color: #EDE9F0; border: 1px solid #2A2D3A; padding: 0.875rem; text-align: center; border-radius: 0.25rem; text-decoration: none; font-size: 0.8125rem; transition: background 0.15s, color 0.15s; }
  .tier-btn:hover { background: #EDE9F0; color: #0D0E11; border-color: #EDE9F0; }
  .tier-btn:focus-visible, .module-link:focus-visible, .subtitle a:focus-visible { outline: 2px solid #C9A96E; outline-offset: 3px; }
  .featured-btn { background: #C9A96E; color: #0D0E11; border-color: #C9A96E; font-weight: bold; }
  .featured-btn:hover { background: #EDE9F0; border-color: #EDE9F0; }
  .modules { margin-top: 4rem; padding-top: 3rem; border-top: 1px solid #1A1C23; }
  .modules-title { font-size: 1.75rem; color: #EDE9F0; margin: 0 0 0.5rem; }
  .modules-sub { font-size: 1rem; margin: 0 0 2rem; }
  .module-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem; margin: 0 0 2rem; }
  .module { background: #111317; border: 1px solid #1A1C23; padding: 1.25rem; border-radius: 0.25rem; }
  .module dt { color: #C9A96E; font-size: 0.8125rem; margin-bottom: 0.4rem; }
  .module dd { margin: 0; font-size: 0.8125rem; line-height: 1.5; }
  .module-link { color: #EDE9F0; font-size: 0.8125rem; }
  .tag-mono { font-family: 'Fira Code', monospace; }
  .text-muted { color: #888; }
  @media (max-width: 768px) { .page-heading { font-size: 2rem; } .tiers-grid { grid-template-columns: minmax(0, 1fr); } }
</style>
