---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import MartechStack from '../components/MartechStack.astro';
import { ogHome } from '../lib/og';
import ContactForm from '../components/ContactForm.astro';
import { platforms, LAUNCH_TEXT } from '../lib/platforms';
import LatestPost from '../components/LatestPost.astro'

const stack = [
  'ASTRO', 'NEXT.JS', 'CRM', 'CDP',
  'ANALYTICS', 'MARKETING_AUTOMATION', 'ADVERTISING',
];
---

<BaseLayout
  title="Michelle Sadsad Luyenga | Marketing Web Developer: Astro & Next.js"
  description="Marketing web developer building fast, measurable websites on Astro and Next.js connected to your CRM, CDP, analytics, email automation, and ad platforms."
  image={ogHome()}>
  <section class="hero-container">
    <div class="hero-badge tag-mono">// MARKETING_WEB_DEVELOPER</div>
    <h1 class="hero-heading">Marketing websites that are fast, measurable, and connected</h1>
    <p class="hero-sub text-muted">
      I build and fix marketing websites on Astro and Next.js, then connect them to your CRM, customer data, analytics, email automation, and ad platforms. Every lead, order, and campaign click is tracked and routed without manual exports.
    </p>
    <p class="availability tag-mono">// OPEN_TO: CLIENT_PROJECTS &amp; FULL-TIME_ROLES</p>

    <div class="hero-cta">
      <a href="/services" class="btn-primary tag-mono">EXPLORE_SERVICES &rarr;</a>
      <a href="/platforms" class="btn-secondary tag-mono">WHICH_PLATFORM_FITS?</a>
      <a href="/contact?stream=consultation" class="btn-secondary tag-mono">START_A_PROJECT</a>
    </div>

    <ul class="stack-matrix tag-mono" aria-label="Platforms and tools I work with">
      {stack.map((item) => <li class="matrix-item">[ {item} ]</li>)}
    </ul>
  </section>

  <section class="platform-section" aria-labelledby="platform-heading">
    <p class="tag-mono accent-text">// PLATFORMS</p>
    <h2 id="platform-heading" class="platform-title">The right platform for the job</h2>
    <p class="text-muted platform-sub">
      I pick the platform from your goals and the tools your team already knows, not the other way around.
    </p>
    <div class="platform-grid">
      {platforms.map((p) => (
        <a href="/platforms" class:list={['platform-card', { flagship: p.role === 'FLAGSHIP' }]}>
          <span class="tag-mono role">[ {p.role === 'SELECTIVE' ? 'WHEN_NEEDED' : p.role} ]</span>
          <span class="platform-name">{p.name}</span>
          <span class="text-muted platform-summary">{p.summary}</span>
        </a>
      ))}
    </div>
    <p class="notice tag-mono">
      // SAMPLE_BUILDS_ON_ALL_2_PLATFORMS: {LAUNCH_TEXT.toUpperCase().replaceAll(' ', '_')}. <a href="/cases">SEE_THE_PLAN</a>
    </p>
  </section>

  <MartechStack />
  <LatestPost />
  <ContactForm />
</BaseLayout>

<style>
  .hero-container { max-width: 64rem; margin: 6rem auto; padding: 0 1.25rem; }
  .hero-badge { color: #C9A96E; font-size: 0.8125rem; margin-bottom: 1rem; }
  .hero-heading { font-size: 3rem; color: #EDE9F0; line-height: 1.15; margin: 0 0 1.5rem 0; max-width: 52rem; }
  .hero-sub { font-size: 1.125rem; line-height: 1.6; max-width: 48rem; margin-bottom: 1.25rem; }
  .availability { color: #C9A96E; font-size: 0.8125rem; margin: 0 0 2.5rem; }
  .hero-cta { display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 4rem; }
  .btn-primary { background: #C9A96E; color: #0D0E11; padding: 0.875rem 1.5rem; border-radius: 0.25rem; text-decoration: none; font-weight: bold; font-size: 0.8125rem; }
  .btn-secondary { background: transparent; color: #EDE9F0; border: 1px solid #1A1C23; padding: 0.875rem 1.5rem; border-radius: 0.25rem; text-decoration: none; font-size: 0.8125rem; }
  .btn-secondary:hover { border-color: #C9A96E; }
  .btn-primary:focus-visible, .btn-secondary:focus-visible { outline: 2px solid #C9A96E; outline-offset: 3px; }
  .stack-matrix { display: flex; gap: 0.75rem; flex-wrap: wrap; list-style: none; margin: 0; font-size: 0.75rem; color: #888; border-top: 1px solid #1A1C23; padding: 2rem 0 0; }
  .matrix-item { background: #111317; border: 1px solid #1A1C23; padding: 0.5rem 1rem; border-radius: 0.25rem; }

  .platform-section { max-width: 64rem; margin: 5rem auto 0; padding: 0 1.25rem; }
  .accent-text { color: #C9A96E; }
  .platform-title { font-size: 2rem; color: #EDE9F0; line-height: 1.2; margin: 0.75rem 0 1rem; }
  .platform-sub { font-size: 1rem; line-height: 1.6; max-width: 44rem; margin: 0 0 2rem; }
  .platform-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 1.25rem; }
  .platform-card { display: flex; flex-direction: column; gap: 0.5rem; background: #111317; border: 1px solid #1A1C23; padding: 1.5rem; border-radius: 0.375rem; text-decoration: none; transition: border-color 0.15s; }
  .platform-card:hover, .platform-card.flagship { border-color: #C9A96E; }
  .platform-card:focus-visible { outline: 2px solid #C9A96E; outline-offset: 3px; }
  .role { font-size: 0.65rem; color: #C9A96E; }
  .platform-name { font-size: 1.375rem; color: #EDE9F0; font-weight: 600; }
  .platform-summary { font-size: 0.85rem; line-height: 1.5; }
  .notice { margin: 1.5rem 0 0; font-size: 0.75rem; color: #888; }
  .notice a { color: #C9A96E; }
  .tag-mono { font-family: 'Fira Code', monospace; }
  .text-muted { color: #888; }
  @media (max-width: 768px) {
    .hero-container { margin: 3rem auto; }
    .hero-heading { font-size: 2.25rem; }
    .platform-title { font-size: 1.625rem; }
  }
</style>
