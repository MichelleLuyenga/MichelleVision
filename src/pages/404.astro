---
// src/pages/404.astro
import BaseLayout from '../layouts/BaseLayout.astro';

const links = [
  { label: 'RETURN_TO_HOME', href: '/' },
  { label: 'VIEW_SERVICES_&_PACKAGES', href: '/services' },
  { label: 'WHICH_PLATFORM_FITS_MY_PROJECT', href: '/platforms' },
  { label: 'READ_CASE_STUDIES_&_SAMPLE_BUILDS', href: '/cases' },
  { label: 'BROWSE_MARTECH_LOGS', href: '/blog' },
  { label: 'START_A_PROJECT', href: '/contact?stream=consultation', highlight: true },
];
---

<BaseLayout
  title="404: Page Not Found | MichelleVision"
  description="The page you requested does not exist on michellevision.com."
  noindex
>
  <section class="error-container">
    <div class="error-header">
      <p class="tag-mono error-tag">// ERROR_CODE: 0X404_ROUTE_NOT_FOUND</p>
      <h1 class="error-title">This page does not exist.</h1>
      <p class="text-muted error-subtitle">
        The link may be broken or the page may have moved. Here are the most useful places to go next.
      </p>
    </div>

    <nav class="reroute-box" aria-label="Helpful links">
      <div class="reroute-header tag-mono">[ INITIATE_RE_ROUTING ]</div>

      <ul class="reroute-links tag-mono">
        {links.map((l) => (
          <li>
            <a href={l.href} class:list={['route-link', { 'highlight-link': l.highlight }]}>
              <span class="arrow" aria-hidden="true">&rarr;</span>
              <span class="link-text">{l.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </section>
</BaseLayout>

<style>
  .error-container { max-width: 42rem; margin: 4rem auto; padding: 0 1.25rem; }
  .error-tag { color: #FF5555; font-weight: bold; font-size: 0.8125rem; letter-spacing: 0.05em; }
  .error-title { font-size: 2.25rem; color: #EDE9F0; margin: 1rem 0; line-height: 1.2; overflow-wrap: break-word; }
  .error-subtitle { font-size: 1rem; line-height: 1.6; margin-bottom: 2.5rem; }
  .reroute-box { background: #111317; border: 1px solid #1A1C23; border-radius: 0.375rem; padding: 1.5rem; width: 100%; box-sizing: border-box; }
  .reroute-header { color: #C9A96E; font-size: 0.8125rem; margin-bottom: 1.5rem; letter-spacing: 0.05em; }
  .reroute-links { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 1.25rem; }
  .route-link { display: flex; align-items: flex-start; gap: 0.75rem; color: #EDE9F0; text-decoration: none; font-size: 0.875rem; transition: color 0.15s; width: 100%; }
  .route-link:hover { color: #C9A96E; }
  .route-link:focus-visible { outline: 2px solid #C9A96E; outline-offset: 3px; }
  .highlight-link { border: 1px dashed #1A1C23; padding: 0.75rem; border-radius: 0.25rem; box-sizing: border-box; }
  .highlight-link:hover { border-color: #C9A96E; }
  .arrow { color: #C9A96E; flex-shrink: 0; }
  /* Lets long monospace labels with underscores wrap on small screens */
  .link-text { flex: 1; min-width: 0; overflow-wrap: anywhere; word-break: break-word; }
  .tag-mono { font-family: 'Fira Code', monospace; }
  .text-muted { color: #888; }
  @media (max-width: 640px) {
    .error-container { margin: 2rem auto; }
    .error-title { font-size: 1.75rem; }
    .reroute-box { padding: 1.25rem; }
    .route-link { font-size: 0.8125rem; }
  }
</style>
